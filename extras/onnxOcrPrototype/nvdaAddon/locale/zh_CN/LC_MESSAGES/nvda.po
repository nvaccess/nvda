msgid "On-device OCR"
msgstr "设备端 OCR"

msgid "OCR &model:"
msgstr "OCR 模型(&M)："

msgid "Tiny (Chinese, English and Latin scripts; fastest)"
msgstr "Tiny（中文、英文和拉丁文字；速度最快）"

msgid "Small (adds Japanese; more accurate)"
msgstr "Small（额外支持日文；准确率更高）"

msgid "Automatically &read the result"
msgstr "自动朗读识别结果(&R)"

msgid "Keep the OCR engine loaded for (seconds):"
msgstr "OCR 引擎保持加载的时间（秒）："

msgid "The selected model is downloaded and SHA-256 verified on first use. Recognition then runs locally; captured images are not uploaded."
msgstr "第一次使用时会下载所选模型并校验 SHA-256。此后的识别在本地进行，不会上传截取的图像。"

msgid "Recognizes the current navigator object using on-device OCR"
msgstr "使用设备端 OCR 识别当前浏览对象"

msgid "On-device OCR is not available. Reinstall the add-on or check its settings."
msgstr "设备端 OCR 不可用。请重新安装插件或检查其设置。"

msgid "The current navigator object is too large for on-device OCR."
msgstr "当前浏览对象过大，无法安全地进行设备端 OCR。"
