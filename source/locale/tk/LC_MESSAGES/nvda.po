#. Translators: Used in server mode to obtain the external IP address for the server (controlled computer) for direct connection.
#: _remoteClient\dialogs.py:197
msgid "Get External &IP"
msgstr "&Daşarky IP-adresi alyň"

#. Translators: Label of the edit field to enter key (password) to secure the Remote Access connection.
#: _remoteClient\dialogs.py:215
msgctxt "remote"
msgid "&Key"
msgstr "&Açar"

#. Translators: Title of a dialog shown to users while attempting to detect their external IP address
#: _remoteClient\dialogs.py:236
msgctxt "remote"
msgid "Getting external IP"
msgstr "Daşarky IP adresini almak"

#. Translators: Message on a dialog shown to users while attempting to detect their external IP address
#: _remoteClient\dialogs.py:238
msgctxt "remote"
msgid "Getting external IP..."
msgstr "Daşarky IP adresini almak..."

#. Translators: Message shown when successfully getting external IP and the specified port is open
#: _remoteClient\dialogs.py:278
#, python-brace-format
msgid "Successfully retrieved IP address. Port {port} is open."
msgstr "Daşarky IP-adres üstünlikli aldy. {port} porty açyk."

#. Translators: Message shown when IP was retrieved but the specified port is not forwarded
#. {port} will be replaced with the actual port number
#: _remoteClient\dialogs.py:289
#, python-brace-format
msgid "Retrieved external IP, but port {port} is most likely not currently forwarded."
msgstr "Daşky IP salgy aldy, Emma {port} porty şu anda geçirilmedik bolup biler."

#. Translators: Error message when unable to get IP address from portcheck server
#: _remoteClient\dialogs.py:304
msgid "Unable to contact portcheck server, please manually retrieve your IP address"
msgstr "Daşarky IP-adresi alyp başarmady. Onu el bilen görkeziň"

#. Translators: Message displayed when the host or key field is empty and the user tries to connect.
#: _remoteClient\dialogs.py:414
msgid "Both host and key must be set."
msgstr "Serwer salgysyny we açary görkezmeli."

#. Translators: Message displayed when the port or key field is empty and the user tries to connect.
#: _remoteClient\dialogs.py:422
msgid "Both port and key must be set."
msgstr "Port we açary görkezmeli."

#. Translators: Title of the dialog presented when attempting to connect to a server with an untrusted certificate.
#: _remoteClient\dialogs.py:480
msgctxt "remote"
msgid "Security Warning"
msgstr "Howpsuzlyk duýdury"

#. Translators: Message presented when attempting to connect to a server with an untrusted certificate.
#. {fingerprint} will be replaced with the SHA256 fingerprint of the server certificate.
#: _remoteClient\dialogs.py:485
#, python-brace-format
msgctxt "remote"
msgid "The certificate of this server could not be verified. Using the wrong fingerprint may allow a third party to access the Remote Access session.\n\n"
"Before continuing, please make sure that the following server certificate fingerprint is correct.\n"
"Server SHA256 fingerprint: {fingerprint}\n\n"
"Continue connecting anyway?"
msgstr "Bu serweriň şahadatnamasy barlamak mümkün däl. Barlanmadyk şahadatnamany ulanmak üçünji tarapyň uzakdan girme seansyna girmegine sebäp bolup bilner.\n\n"
"Dowam etmezden ozal, aşakdaky serwer şahadatnamasynyň dogry görkezilendigine göz ýetiriň.\n"
"Serwer şahadatnamasy SHA256: {fingerprint}\n\n"
"Birikdirmäge dowam etmeli?"

#. Translators: A button to connect and remember the server with unauthorized certificate.
#: _remoteClient\dialogs.py:500
msgid "Connect and do not ask again for this server"
msgstr "Birigiň we bu serwer barada indik soramaň"

#. Translators: A button to connect and ask again for the server with unauthorized certificate.
#: _remoteClient\dialogs.py:502
msgid "Connect"
msgstr "Birikdirme"

#. Translators: Message displayed when a remote computer tries to send control+alt+delete but UI Access is disabled.
#: _remoteClient\localMachine.py:367
msgctxt "remote"
msgid "Unable to trigger control+alt+delete"
msgstr "Alt Control Delete ibermek mümkin däl"

#. Translators: Menu item in Remote Access submenu to mute speech and sounds from the remote computer.
#: _remoteClient\menu.py:32
msgid "Mute remote"
msgstr "Uzakdan kompýuteriň sözleýiş we seslerini öçür"

#. Translators: Tooltip for the Mute Remote menu item in the Remote Access submenu.
#: _remoteClient\menu.py:34
msgctxt "remote"
msgid "Mute speech and sounds from the remote computer."
msgstr "Umlandyrylýan komputeriň sözleýiş we seslerini öçürär."

#. Translators: Menu item in the Remote Access submenu to send the contents of the clipboard to the remote computer.
#: _remoteClient\menu.py:42
msgctxt "remote"
msgid "&Send clipboard"
msgstr "&Bufer çalşyrmak"

#. Translators: Tooltip for the Send clipboard menu item in the Remote Access submenu.
#: _remoteClient\menu.py:44
msgctxt "remote"
msgid "Send the clipboard text to the remote computer."
msgstr "Doly buferden teksti uzakdan dolandyrylýan kompiýtere iberýär."

#. Translators: Menu item in the Remote Access submenu to copy a link to the current session.
#: _remoteClient\menu.py:55
msgid "Copy &link"
msgstr "Uzakdan giriş seansyna &baglanyşyk göçürip al"

#. Translators: Tooltip for the Copy Link menu item in the Remote Access submenu.
#: _remoteClient\menu.py:57
msgctxt "remote"
msgid "Copy a link to the current Remote Access session to the clipboard."
msgstr "Häzirki uzakdan giriş sessiýasyna baglanyşygy bufer çalşa göçürär."

#. Translators: Menu item in the Remote Access submenu to send Control+Alt+Delete to the remote computer.
#: _remoteClient\menu.py:68
msgctxt "remote"
msgid "S&end control+alt+delete"
msgstr "I&ber ctrl+alt+delete"

#. Translators: Tooltip for the Send Control+Alt+Delete menu item in the Remote Access submenu.
#: _remoteClient\menu.py:70
msgctxt "remote"
msgid "Send control+alt+delete to the controlled computer."
msgstr "Control+alt+delete buýrugyny umlandyrylýan komputere iberär."

#. Translators: Label of the Remote Access submenu in the NVDA tools menu.
#: _remoteClient\menu.py:81
msgctxt "remote"
msgid "R&emote Access"
msgstr "U&zakdan giriş"

#. Translators: Tooltip for the Remote Access submenu in the NVDA Tools menu.
#: _remoteClient\menu.py:85
msgctxt "remote"
msgid "Allow someone to control this computer from elsewhere, or control another computer running NVDA with this one."
msgstr "Biriniň bu komputere başga ýerden dolandyrmagyna rugsat beriň ýa-da bu komputer bilen NVDA açyk başga komputeri dolandyryň."

#. Translators: Item in the Remote Access submenu to connect to another computer.
#: _remoteClient\menu.py:156
msgid "Connect..."
msgstr "Birigiň..."

#. Translators: Tooltip for the Connect menu item in the Remote Access submenu.
#: _remoteClient\menu.py:158
msgctxt "remote"
msgid "Remotely connect to another computer running NVDA."
msgstr "NVDA dolandyrylýan başga komputere uzakdan birikdirme."

#. Translators: Menu item in the Remote Access submenu to disconnect from another computer running NVDA.
#: _remoteClient\menu.py:176
msgid "Disconnect"
msgstr "Aýyrlyş"

#. Translators: Tooltip for the Disconnect menu item in the Remote Access submenu.
#: _remoteClient\menu.py:178
msgctxt "remote"
msgid "Disconnect from the current Remote Access session."
msgstr "Häzirki uzakdan giriş sessiýasyndan aýrylar."

#. Translators: Message presented when attempting to connect to an incompatible Remote Access server.
#: _remoteClient\session.py:173
msgctxt "remote"
msgid "The Remote Access server you have connected to is not compatible with this version of NVDA. Please use a different server."
msgstr "Siz birikdirilen uzakdan girmegiň serweri, NVDA-nyň bu wersiýasy bilen gabat gelmeýär. Başga serwer ulanyň."

#. Translators: Title of a dialog showing a message sent by a Remote Access server.
#: _remoteClient\session.py:193
msgctxt "remote"
msgid "Message from Remote Access Server"
msgstr "Uzakdan giriş serverinden habar"

#. Translators: Message for when the remote NVDA is not connected
#: _remoteClient\session.py:555
msgctxt "remote"
msgid "Remote NVDA not connected"
msgstr "Umlandyrylýan komputerde NVDA birikdirilmedik"

