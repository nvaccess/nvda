#. Translators: The label of a button to continue with the operation.
#. Translators: The label for the Continue button in an NVDA dialog.
#: gui\installerGui.py:495 gui\installerGui.py:852 gui\nvdaControls.py:370
msgid "&Continue"
msgstr "Da&vam et"

#. Translators: A warning presented when the user attempts to downgrade NVDA
#. to an older version.
#: gui\installerGui.py:549
msgid "You are attempting to install an earlier version of NVDA than the version currently installed. If you really wish to revert to an earlier version, you should first cancel this installation and completely uninstall NVDA before installing the earlier version."
msgstr "Siz hazırda quraşdırılmış versiyadan daha köhnə NVDA versiyasını quraşdırmağa çalışırsınız. Əgər həqiqətən köhnə versiyaya qayıtmaq istəyirsinizsə, əvvəlcə bu quraşdırmanı ləğv etməli və köhnə versiyanı quraşdırmazdan əvvəl NVDA-nı tamamilə silməlisiniz."

#. Translators: A warning presented when the installer is unable to determine
#. the state of the current NVDA installation.
#: gui\installerGui.py:559
msgid "An existing NVDA installation has been detected, but its version cannot be determined. If you are attempting to install an earlier version of NVDA, you should first cancel this installation and completely uninstall NVDA before installing the earlier version."
msgstr "Mövcud NVDA quraşdırması aşkar edildi, lakin onun versiyası təyin edilə bilmir. Əgər NVDA-nın daha köhnə versiyasını quraşdırmağa çalışırsınızsa, əvvəlcə bu quraşdırmanı ləğv etməli və köhnə versiyanı quraşdırmazdan əvvəl NVDA-nı tamamilə silməlisiniz."

#. Translators: The label of a button to proceed with installation,
#. even though this is not recommended.
#: gui\installerGui.py:586
msgid "&Proceed with installation (not recommended)"
msgstr "&Quraşdırmaya davam et (tövsiyə edilmir)"

#. Translators: A warning presented when the user attempts to downgrade NVDA
#. to an older version.
#: gui\installerGui.py:618
msgid "You are attempting to replace an existing portable copy of NVDA with an earlier version. Downgrading NVDA is not recommended. You should cancel this operation and create a new portable copy instead. "
msgstr "Siz mövcud portativ NVDA kopyasını daha köhnə versiya ilə əvəz etməyə çalışırsınız. NVDA versiyasının aşağı salınması tövsiyə edilmir. Bu əməliyyatı ləğv etməli və əvəzinə yeni portativ kopya yaratmalısınız. "

#. Translators: A warning presented when the installer is unable to determine
#. the state of the current NVDA installation.
#: gui\installerGui.py:626
msgid "An existing copy of NVDA has been detected in the chosen directory, but its version cannot be determined. If you are attempting to downgrade to an earlier version of NVDA, you should cancel this operation and create a new portable copy. "
msgstr "Seçilmiş qovluqda NVDA-nın mövcud nüsxəsi aşkar edildi, lakin onun versiyası təyin edilə bilmədi. Əgər NVDA-nın daha əvvəlki versiyasına qayıtmağa çalışırsınızsa, bu əməliyyatı ləğv etməli və yeni daşınan nüsxə yaratmalısınız. "

#. Translators: The message displayed when the user has specified a destination directory
#. that already has a portable copy in the Create Portable NVDA dialog.
#: gui\installerGui.py:667
#, python-brace-format
msgid "A portable copy already exists in the directory '{portableDirectory}'. Do you want to update it?"
msgstr "'{portableDirectory}' qovluğunda artıq daşınan nüsxə mövcuddur. Onu yeniləmək istəyirsiniz?"

#. Translators: The title of a dialog presented when the user has specified a destination directory
#. that already has a portable copy in the Create Portable NVDA dialog.
#: gui\installerGui.py:672
msgid "Portable Copy Exists"
msgstr "Daşınan nüsxə mövcuddur"

#. Translators: The message displayed when the user has specified a destination directory
#. that already exists in the Create Portable NVDA dialog.
#: gui\installerGui.py:689
#, python-brace-format
msgid "The specified directory '{portableDirectory}' is not empty. Proceeding will delete and replace existing files in the directory. Do you want to overwrite the contents of this folder? "
msgstr "Göstərilən '{portableDirectory}' qovluğu boş deyil. Davam etdikdə qovluqdakı mövcud fayllar silinəcək və əvəz olunacaq. Bu qovluğun məzmununun üzərinə yazmaq istəyirsiniz? "

#. Translators: The title of a dialog presented when the user has specified a destination directory
#. that already exists in the Create Portable NVDA dialog.
#: gui\installerGui.py:695
msgid "Directory Exists"
msgstr "Qovluq mövcuddur"

#. Translators: Message shown to users when attempting to install NVDA
#. on a computer which is being remotely controlled via NVDA Remote Access
#: gui\installerGui.py:715
msgid "Installing NVDA when connected to NVDA Remote Access as the controlled computer is not recommended. "
msgstr "NVDA-ya uzaqdan giriş vasitəsilə idarə olunan kompüter kimi bağlı olduğunuz zaman NVDA-nı quraşdırmaq tövsiyə edilmir. "

#. Translators: Message shown to users when attempting to install or update NVDA from the launcher
#. on a computer which is being remotely controlled via NVDA Remote Access
#: gui\installerGui.py:721
msgid "You will be unable to respond to User Account Control (UAC) prompts from the controlling computer. You should only proceed if you have physical access to the controlled computer.\n\n"
"Are you sure you want to continue?"
msgstr "Siz idarəedici kompüterdən İstifadəçi Hesabının Nəzarəti (UAC) sorğularına cavab verə bilməyəcəksiniz. Yalnız idarə olunan kompüterə fiziki girişiniz varsa davam etməlisiniz.\n\n"
"Davam etmək istədiyinizə əminsiniz?"

#. Translators: The message displayed when the user has not specified a destination directory
#. in the Create Portable NVDA dialog.
#: gui\installerGui.py:763
msgid "Please specify a directory in which to create the portable copy."
msgstr "Zəhmət olmasa, daşınan kopyanın yaradılacağı qovluğu təyin edin."

#. Translators: The message displayed when the user has specified a destination directory
#. in the Create Portable NVDA dialog that has a drive letter with no backslash after it,
#. such as "D:" or "D:folder".
#. {drive} is the drive letter and colon the user typed, such as "D:".
#. {path} is the destination directory the user specified.
#: gui\installerGui.py:777
#, python-brace-format
msgid "Please specify the absolute path where the portable copy should be created. The drive letter must be followed by a backslash: use {drive}\\ for the root of the drive, or {drive}\\folder for a folder on it.\n"
"Current path: {path}. "
msgstr ""

#. Translators: The message displayed when the user has not specified an absolute destination directory
#. in the Create Portable NVDA dialog.
#: gui\installerGui.py:786
#, python-brace-format
msgid "Please specify the absolute path where the portable copy should be created. It must start with a drive letter (e.g. C:\\). It may include system variables (e.g. %temp%, %homepath%) as placeholders for parts of the path.\n"
"Current path: {path}. "
msgstr ""

