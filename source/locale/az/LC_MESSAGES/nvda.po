#: _remoteClient\dialogs.py:81
msgctxt "remote"
msgid "Generating key..."
msgstr "Açar yaradılır..."

#. Translators: Message shown to users when requesting that a Remote Access server generate a key fails.
#. {host} will be replaced with the address of the Remote Access server.
#: _remoteClient\dialogs.py:125
#, python-brace-format
msgctxt "remote"
msgid "Unable to connect to {host}. Check that you have internet access, and that there are no mistakes in the host field."
msgstr "{host} ilə bağlanmaq mümkün olmadı. İnternetə çıxışınızın olduğunu və host sahəsində səhv olmadığını yoxlayın."

